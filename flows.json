    {
        "id": "7daa6b8e5e8b5c1d",
        "type": "function",
        "z": "f62c0d617e212335",
        "name": "Process Temp",
        "func": "let db = msg.payload || {};\nlet temp = parseFloat(db.temp) || 0;\n\n// Extract the new Humidity data\nlet hum = parseFloat(db.hum) || 0;\n\nlet time = db.last_updated || db.Timestamp || new Date().toLocaleString('sv-SE', { timeZone: 'Asia/Kuala_Lumpur' });\n\n// Add the 'hum' variable to our status message\nlet statusMsg = { topic: \"m1\", time: time, hum: hum };\n\n// Trigger the Red Alarm if it gets too hot OR if Firebase says \"FIRE!!\"\nif (temp >= 28 || db.status === \"FIRE!!\" || db.status === \"Alarm\") {\n    statusMsg.payload = \"CRITICAL ALARM\"; statusMsg.color = \"#d32f2f\";\n} else {\n    statusMsg.payload = \"SYSTEM SECURE\"; statusMsg.color = \"#2e7d32\";\n}\n\nlet gaugeMsg = { payload: temp };\nreturn [gaugeMsg, statusMsg];",
