    {
        "id": "02510b2fb79650ed",
        "type": "function",
        "z": "f62c0d617e212335",
        "name": "Process Door",
        "func": "let db = msg.payload || {};\nlet val = String(db.Access_Status).toUpperCase();\n\nlet time = db.Timestamp || new Date().toLocaleString('en-US', { timeZone: 'Asia/Kuala_Lumpur' });\n\nlet history = flow.get('m4_history') || [];\nlet status = val.includes('DENIED') ? 'ACCESS DENIED' : 'DOOR UNLOCKED';\nlet color = val.includes('DENIED') ? '#d32f2f' : '#2e7d32';\n\n// --- NEW: Save the door status to Node-RED's memory so M5 can read it! ---\nflow.set('is_door_unlocked', status === 'DOOR UNLOCKED');\n\nif (history.length === 0 || history[0].status !== status) {\n    history.unshift({ time: time, status: status, color: color });\n    if (history.length > 5) history.pop();\n    flow.set('m4_history', history);\n}\n\nreturn { payload: status, color: color, time: time, history: history, topic: \"m4\" };",
