    {
        "id": "18080c6fc05d6c08",
        "type": "ui_template",
        "z": "f62c0d617e212335",
        "group": "bee0ea0db699c4dc",
        "name": "SMART HOME COMMAND CENTER",
        "order": 2,
        "width": "0",
        "height": "0",
        "format": "<div style=\"text-align: center; margin-bottom: 20px;\">\n    <h2 style=\"margin: 0; color: #c9d1d9;\">SMART HOME COMMAND CENTER</h2>\n    <p style=\"color: #8b949e; margin-top: 5px;\"><span style=\"color:#2e7d32;\">●</span> Real-time System Status</p>\n</div>\n<div class='overview-container'>\n    <div class='overview-card'>\n        <div class='overview-title'>🔥 M1: Fire</div>\n        <div class='overview-value' style='color:{{msg.payload.m1.color}}'>{{msg.payload.m1.payload}}</div>\n        <div class='overview-time'>{{msg.payload.m1.time}}</div>\n    </div>\n    <div class='overview-card'>\n        <div class='overview-title'>💡 M2: Lights</div>\n        <div class='overview-value' style='color:{{msg.payload.m2.color}}'>{{msg.payload.m2.payload}}</div>\n        <div class='overview-time'>{{msg.payload.m2.time}}</div>\n    </div>\n    <div class='overview-card'>\n        <div class='overview-title'>🌀 M3: Fan</div>\n        <div class='overview-value' style='color:{{msg.payload.m3.color}}'>{{msg.payload.m3.payload}}</div>\n        <div class='overview-time'>{{msg.payload.m3.time}}</div>\n    </div>\n    <div class='overview-card'>\n        <div class='overview-title'>🚪 M4: Door</div>\n        <div class='overview-value' style='color:{{msg.payload.m4.color}}'>{{msg.payload.m4.payload}}</div>\n        <div class='overview-time'>{{msg.payload.m4.time}}</div>\n    </div>\n    <div class='overview-card'>\n        <div class='overview-title'>🛡️ M5: Radar</div>\n        <div class='overview-value' style='color:{{msg.payload.m5.color}}'>{{msg.payload.m5.payload}}</div>\n        <div class='overview-time'>{{msg.payload.m5.time}}</div>\n    </div>\n</div>",
        "storeOutMessages": true,
