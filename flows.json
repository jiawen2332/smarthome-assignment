    {
        "id": "96f0ec693c6e0d57",
        "type": "function",
        "z": "f62c0d617e212335",
        "name": "Process Lux",
        "func": "let db = msg.payload || {};\nlet lux = parseInt(db.Lux_Intensity) || 0;\n\nlet time = db.Timestamp || db.last_updated || new Date().toLocaleString('sv-SE', { timeZone: 'Asia/Kuala_Lumpur' });\n\nlet mode = db.Control_Mode || db.Mode || \"AUTO\";\nlet lightVal = String(db.light_control);\n\n// CORRECTED: 1 means ON\nlet isLightOn = (lightVal === \"1\" || lightVal === \"ON\" || lightVal === \"true\");\n\nlet lightStatus = db.Light_Status || \"UNKNOWN\";\n\nlet color = '#444444';\nif (mode === \"AUTO\") color = '#1f77b4';\nelse if (mode !== \"AUTO\" && isLightOn) color = '#f9a825';\n\nlet statusPayload = `[${mode}] LIGHT ${lightStatus} | LUX: ${lux}`;\n\nlet gaugeMsg = { payload: lux };\nlet statusMsg = { topic: \"m2\", time: time, payload: statusPayload, color: color };\n\nlet isManual = (mode === \"MANUAL\");\n\n// CORRECTED: Send 1 back for ON, 0 back for OFF\nlet switchState = isLightOn ? \"1\" : \"0\";\nlet switchMsg = { payload: switchState, enabled: isManual };\n\nreturn [gaugeMsg, statusMsg, switchMsg];",
        "outputs": 3,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
