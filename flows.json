        "name": "",
        "order": 1,
        "width": 0,
        "height": 0,
        "format": "<style>\n    body { background-color: #0d1117 !important; color: white !important; }\n    .nr-dashboard-group {\n        background-color: #161b22 !important; border-radius: 12px !important;\n        border: 1px solid #30363d !important; box-shadow: 0 4px 10px rgba(0,0,0,0.3) !important;\n        margin: 12px !important; padding: 10px !important;\n    }\n    .nr-dashboard-group-title {\n        color: #8b949e !important; font-weight: bold !important;\n        text-transform: uppercase; letter-spacing: 1px; margin-bottom: 10px !important;\n        border-bottom: 1px solid #30363d; padding-bottom: 5px;\n    }\n    md-tabs, md-tabs-wrapper, md-tab-item {\n        position: relative !important; z-index: 9999 !important;\n        pointer-events: auto !important; cursor: pointer !important;\n    }\n    .overview-container {\n        display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 15px;\n    }\n    .overview-card {\n        padding: 20px; border-radius: 10px; background: #21262d;\n        border: 1px solid #30363d; text-align: center;\n        transition: transform 0.2s, box-shadow 0.2s;\n    }\n    .overview-card:hover {\n        transform: translateY(-5px); box-shadow: 0 8px 15px rgba(0,0,0,0.5);\n    }\n    .overview-title { font-size: 13px; color: #8b949e; text-transform: uppercase; margin-bottom: 10px; font-weight: bold; }\n    .overview-value { font-size: 20px; font-weight: bold; margin-bottom: 5px; }\n    .overview-time { font-size: 11px; color: #6e7681; }\n    .log-table { width:100%; border-collapse:collapse; color:#fff; font-size:13px; text-align:center; }\n    .log-table th { background-color: #21262d; padding: 10px; color: #8b949e; border: 1px solid #30363d; }\n    .log-table td { border:1px solid #30363d; padding:10px; }\n</style>",
