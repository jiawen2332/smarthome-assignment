    {
        "id": "7d2b844e3b38f2fd",
        "type": "function",
        "z": "f62c0d617e212335",
        "name": "Overview Aggregator",
        "func": "let over = flow.get('home_overview') || {\n    m1: {payload: 'WAITING', color: '#8b949e', time: '--:--'},\n    m2: {payload: 'WAITING', color: '#8b949e', time: '--:--'},\n    m3: {payload: 'WAITING', color: '#8b949e', time: '--:--'},\n    m4: {payload: 'WAITING', color: '#8b949e', time: '--:--'},\n    m5: {payload: 'WAITING', color: '#8b949e', time: '--:--'}\n};\nif(msg.topic && over[msg.topic]) {\n    over[msg.topic] = { payload: msg.payload, color: msg.color, time: msg.time };\n    flow.set('home_overview', over);\n}\nmsg.payload = over;\nreturn msg;",
        "outputs": 1,
