    {
        "id": "3c565635bd801264",
        "type": "function",
        "z": "f62c0d617e212335",
        "name": "Process Fan",
        "func": "let db = msg.payload || {};\n\n// 1. Extract Status\nlet ventStatus = db.Vent_Status || \"WAITING...\";\n\n// 2. Smart Temperature Memory (The Fix)\n// Get the last known good temperature from Node-RED's memory\nlet lastTemp = flow.get('m3_last_temp') || 0;\nlet currentTemp = lastTemp; // Default to the memorized temperature\n\n// Check if new temperature data actually arrived in this specific update\nif (db.Temperature !== undefined && db.Temperature !== null && db.Temperature !== \"\") {\n    // Clean it and make sure it's a real number\n    let parsedTemp = parseFloat(String(db.Temperature).replace(/[^0-9.-]+/g, \"\"));\n    if (!isNaN(parsedTemp)) {\n        currentTemp = parsedTemp;\n        flow.set('m3_last_temp', currentTemp); // Save this good number for next time!\n    }\n}\n\nlet ventTemp = currentTemp.toFixed(1);\n\n// --- 26°C THRESHOLD OVERRIDE ---\nif (currentTemp >= 27) {\n    ventStatus = \"ALERT\";\n}\n\nlet time = db.Timestamp || db.last_updated || new Date().toLocaleString('sv-SE', { timeZone: 'Asia/Kuala_Lumpur' });\n\n// 3. Dynamic Colors\nlet color = '#1f77b4';\nif (ventStatus.includes(\"ALERT\")) {\n    color = '#d32f2f';\n} else if (ventStatus.includes(\"OPEN\") || ventStatus === \"ON\") {\n    color = '#2e7d32';\n} else {\n    color = '#8b949e';\n}\n\nlet statusPayload = `[AUTO] ${ventStatus} | TEMP: ${ventTemp}°C`;\n\n// 4. Smart Stabilized History Log\nlet history = flow.get('m3_history') || [];\n\n// Only create a NEW row if the status actually changes\nif (history.length === 0 || history[0].coreStatus !== ventStatus) {\n    history.unshift({\n        time: time,\n        status: statusPayload,\n        coreStatus: ventStatus,\n        color: color\n    });\n    if (history.length > 5) history.pop();\n} else {\n    // Update the existing row smoothly\n    history[0].status = statusPayload;\n    history[0].time = time;\n}\nflow.set('m3_history', history);\n\n// 5. Pack the message\nmsg.payload = statusPayload;\nmsg.color = color;\nmsg.time = time;\nmsg.history = history;\nmsg.topic = \"m3\";\n\nmsg.ventTemp = ventTemp;\nmsg.ventStatus = ventStatus;\n\nreturn msg;",
