    {
        "id": "a189f9470baf6c8d",
        "type": "function",
        "z": "f62c0d617e212335",
        "name": "Process Distance",
        "func": "let db = msg.payload || {};\nlet dist = parseFloat(db.distance_cm) || 0;\n\nlet time = db.last_updated || db.Timestamp || new Date().toLocaleString('sv-SE', { timeZone: 'Asia/Kuala_Lumpur' });\n\n// --- NEW: Read the door status from Module 4 ---\nlet isDoorUnlocked = flow.get('is_door_unlocked') === true;\n\nlet statusMsg = { topic: \"m5\", time: time, dist: dist };\n\n// --- NEW: Smart Logic ---\nif (dist <= 50) {\n    if (isDoorUnlocked) {\n        statusMsg.payload = \"AUTHORIZED PRESENCE\"; \n        statusMsg.color = \"#1f77b4\"; // Smart Blue to show they are allowed\n    } else {\n        statusMsg.payload = \"INTRUSION DETECTED\"; \n        statusMsg.color = \"#d32f2f\"; // Red Alert!\n    }\n} else {\n    statusMsg.payload = \"AREA SECURE\"; \n    statusMsg.color = \"#2e7d32\"; // Green Safe\n}\n\nlet history = flow.get('m5_history') || [];\nif (history.length === 0 || history[0].status !== statusMsg.payload) {\n    history.unshift({ time: time, dist: dist, status: statusMsg.payload, color: statusMsg.color });\n    if (history.length > 5) history.pop();\n    flow.set('m5_history', history);\n}\nstatusMsg.history = history;\n\nlet gaugeMsg = { payload: dist };\nreturn [gaugeMsg, statusMsg];",
